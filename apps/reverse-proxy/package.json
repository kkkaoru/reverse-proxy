{
  "name": "@reverse-proxy/worker",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "scripts": {
    "setup": "./scripts/setup-wrangler.sh",
    "test": "bunx vitest run --config vitest.config.ts",
    "test:coverage": "bunx vitest run --coverage --config vitest.config.ts",
    "tsc": "bunx tsc --noEmit",
    "typecheck": "bunx tsgo --project tsconfig.json",
    "biome": "bunx biome check src tests vitest.config.ts",
    "lint": "bunx biome check src tests vitest.config.ts",
    "lint:fix": "bunx biome check --write src tests vitest.config.ts",
    "deploy": "./scripts/deploy.sh",
    "upload-endpoints": "./scripts/upload-endpoints-to-kv.sh"
  }
}
