# Copy this file to `.dev.vars` and adjust values for local development.
# Ensure `.dev.vars` stays untracked.

# Cloudflare account binding used by Wrangler CLI.
CLOUDFLARE_ACCOUNT_ID="<account-id>"

# KV namespace ID for caching.
CLOUDFLARE_KV_NAMESPACE_ID="<kv-namespace-id>"

# Shared D1 database, used by both primary and secondary workers.
CLOUDFLARE_D1_DATABASE_NAME="<d1-database-name>"
CLOUDFLARE_D1_DATABASE_ID="<d1-database-id>"

# Custom domains:
#   API_DOMAIN                  -> original shared domain, now fronted by LB.
#   PRIMARY_WORKER_DOMAIN       -> dedicated subdomain for worker A (LB pool origin).
#   SECONDARY_WORKER_DOMAIN     -> dedicated subdomain for worker B (LB pool origin).
PRIMARY_WORKER_DOMAIN="reverse-proxy-a.api.kkk4oru.com"
SECONDARY_WORKER_DOMAIN="reverse-proxy-b.api.kkk4oru.com"

# Cloudflare Load Balancer configuration (used by scripts/setup-load-balancer.sh)
CLOUDFLARE_ZONE_ID="<zone-id>"
CLOUDFLARE_API_TOKEN_LB="<api-token-with-Load-Balancing-edit-and-Zone-DNS-edit>"

# Custom domain (subdomain of kkk4oru.com) used to serve the Worker.
API_DOMAIN="<api-domain.example.com>"

# Optional: enable verbose logging from the proxy middleware.
LOG_REQUESTS="0"

# Cache version for KV key prefix (e.g., v5).
CACHE_VERSION="v5"

# ============================================================
# IP Rotate Configuration (Optional)
# ============================================================
# These settings enable IP rotation via AWS API Gateway.
# If not configured, requests will be made directly without IP rotation.

# JSON object mapping target domains to API Gateway endpoints.
# Format: {"domain":["endpoint1","endpoint2",...]}
# Example: {"example.com":["https://api1.execute-api.us-east-1.amazonaws.com","https://api2.execute-api.us-west-2.amazonaws.com"]}
# IP_ROTATE_ENDPOINTS=""

# Authentication type for IP rotation endpoints.
# Options: "api-key" or "iam"
# IP_ROTATE_AUTH_TYPE=""

# API key for IP rotation (required when IP_ROTATE_AUTH_TYPE="api-key").
# IP_ROTATE_API_KEY=""

# AWS credentials for IP rotation (required when IP_ROTATE_AUTH_TYPE="iam").
# IP_ROTATE_AWS_ACCESS_KEY_ID=""
# IP_ROTATE_AWS_SECRET_ACCESS_KEY=""
# IP_ROTATE_AWS_REGION=""

# Banned regions for IP rotation (comma-separated).
# Endpoints in these regions will be excluded from rotation.
# IP_ROTATE_BANNED_REGIONS="eu-west-1,eu-west-2,eu-west-3,eu-central-1,eu-north-1"

# Default fetch timeout in milliseconds (optional, default: 2000).
# DEFAULT_TIMEOUT_MS="3000"
